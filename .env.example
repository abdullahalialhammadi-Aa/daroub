DAROUB_OWNER_IDS=
DAROUB_EDITOR_IDS=
DAROUB_READ_ONLY=false
# Optional generative AI stays disabled unless explicitly configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Selectable providers for AI wording (each needs its key; the model is required except for Claude, which defaults to claude-opus-5).
# The user picks one per request; AI_DEFAULT_PROVIDER (grok | codex | claude | custom) orders the list.
AI_GROK_API_KEY=
AI_GROK_MODEL=
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=
AI_DEFAULT_PROVIDER=
# Optional paid imagery for the area view (keys stay on the server; tiles are proxied by /api/tiles).
# Google Map Tiles API key (Google Cloud console -> APIs & Services -> enable "Map Tiles API" -> Credentials -> API key restricted to the Map Tiles API).
IMAGERY_GOOGLE_KEY=
# Mapbox access token with the Raster Tiles scope (account.mapbox.com -> Tokens).
IMAGERY_MAPBOX_TOKEN=
# Which provider comes first in the layer switcher (google | mapbox).
IMAGERY_DEFAULT=
